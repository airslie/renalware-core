      <script>var ControllerFactory =
    Packages.com.mirth.connect.server.controllers.ControllerFactory;

var factory = ControllerFactory.getFactory();
var engineController = factory.createEngineController();
var channelController = factory.createChannelController();

function requiredConfig(key) {
    var value = configurationMap.get(key);

    if (value === null || String(value).trim() === &quot;&quot;) {
        throw &quot;Missing Mirth configuration value: &quot; + key;
    }

    return String(value);
}

function channelState(channelId) {
    var status = engineController.getChannelStatus(channelId);

    if (status === null || status.getState() === null) {
        return &quot;UNDEPLOYED&quot;;
    }

    return String(status.getState());
}

var statistics = engineController.getChannelStatisticsList(null, true);
var channels = [];
var serverId = null;

for (var index = 0; index &lt; statistics.size(); index++) {
    var stats = statistics.get(index);
    var channelId = String(stats.getChannelId());
    var channel = channelController.getChannelById(channelId);

    if (serverId === null &amp;&amp; stats.getServerId() !== null) {
        serverId = String(stats.getServerId());
    }

    channels.push({
        id: channelId,
        name: channel === null ? channelId : String(channel.getName()),
        state: channelState(channelId),
        received: Number(stats.getReceived()),
        sent: Number(stats.getSent()),
        error: Number(stats.getError()),
        filtered: Number(stats.getFiltered()),
        queued: Number(stats.getQueued())
    });
}

channels.sort(function(left, right) {
    return left.name.toLowerCase().localeCompare(right.name.toLowerCase());
});

var report = {
    schema_version: 1,
    report_id: String(java.util.UUID.randomUUID().toString()),
    reported_at: String(java.time.Instant.now().toString()),
    source: &quot;mirth_connect&quot;,
    site_id: requiredConfig(&quot;monitoring.site_id&quot;),
    instance_id: requiredConfig(&quot;monitoring.instance_id&quot;),
    server_id: serverId,
    channels: channels
};

var payload = JSON.stringify(report);

return payload;</script>
