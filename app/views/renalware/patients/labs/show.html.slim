= within_patient_layout(title: "Lab") do
  - if Renalware::Heidi::Client.configured?
    .panel
      h2 Heidi WIP
      - if heidi_link_status.success?
        - account = heidi_link_status.body.fetch("account", {})
        p
          strong Link status:
          =< heidi_link_status.body["is_linked"] ? "linked" : "not linked"
        - if account.present?
          p
            strong Heidi EHR user:
            =< [account["ehr_email"], account["ehr_user_id"]].compact.join(" / ")
      - else
        p
          strong Link status:
          =< "could not be checked"
        p= heidi_link_status.error
      - if heidi_link_status.success? && heidi_link_status.body["is_linked"]
        = button_to "Launch Heidi session",
                    patient_heidi_session_path(patient),
                    method: :post,
                    class: "button",
                    form: { target: "_blank", rel: "noopener" }
      - else
        = button_to "Link Heidi account",
                    patient_heidi_linked_account_path(patient),
                    method: :post,
                    class: "button"
      - if heidi_sessions.any?
        h3 Recent Heidi sessions
        table
          thead
            tr
              th Created
              th Status
              th Note
              th
              th Outputs
          tbody
            - heidi_sessions.each do |session|
              tr
                td= l(session.created_at)
                td= session.status.humanize
                td= session.consult_note_status.presence || "Not synced"
                td
                  = button_to "Sync note",
                              patient_heidi_session_sync_path(patient, session),
                              method: :post,
                              class: "button secondary"
                td
                  = form_with url: patient_heidi_session_outputs_path(patient, session), method: :post do
                    = text_field_tag :document_template_id,
                                     session.document_template_id,
                                     placeholder: "Heidi document template ID"
                    = submit_tag "Generate outputs", class: "button secondary"
                - if session.consult_note.present?
                  tr
                    td(colspan=5)
                      details
                        summary Synced note
                        pre.whitespace-pre-wrap= session.consult_note
                - if session.document_content.present?
                  tr
                    td(colspan=5)
                      details
                        summary Heidi document
                        pre.whitespace-pre-wrap= session.document_content
                - if session.structured_response.present?
                  tr
                    td(colspan=5)
                      details
                        summary Heidi structured response
                        pre.whitespace-pre-wrap= JSON.pretty_generate(session.structured_response)
                - if session.clinical_codes_response.present?
                  tr
                    td(colspan=5)
                      details
                        summary Heidi clinical codes
                        pre.whitespace-pre-wrap= JSON.pretty_generate(session.clinical_codes_response)
                - if session.outputs_error.present?
                  tr
                    td(colspan=5)
                      details
                        summary Heidi output error
                        pre.whitespace-pre-wrap= session.outputs_error

  - slots.each do |slot|
    .lab-slot
      = sql_view_widgets_for(slot,
                             patient: patient,
                             lab: true,
                             schema_name: "site",
                             require_patient_scope: true)
