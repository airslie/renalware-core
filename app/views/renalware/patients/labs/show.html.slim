= within_patient_layout(title: "Lab") do
  - if Renalware::Heidi::Client.configured?
    .panel(data-controller="heidi-linked-account"
           data-heidi-linked-account-url-value=patient_heidi_linked_account_path(patient))
      h2 Heidi WIP
      p
        strong Renalware EHR user:
        =< [current_user.email, current_user.uuid].compact.join(" / ")
      - if heidi_link_status.success?
        - account = heidi_link_status.body.fetch("account", {})
        p
          strong Link status:
          span(data-heidi-linked-account-target="status")
            =< heidi_link_status.body["is_linked"] ? "linked" : "not linked"
        - if account.present?
          p
            strong Heidi EHR user:
            =< [account["ehr_email"], account["ehr_user_id"]].compact.join(" / ")
      - else
        p
          strong Link status:
          =< "could not be checked"
        p= heidi_link_status.error
      - if heidi_link_status.success? && heidi_link_status.body["is_linked"]
        = button_to "Launch Heidi session",
                    patient_heidi_session_path(patient),
                    method: :post,
                    class: "button",
                    form: { target: "_blank", rel: "noopener" }
      - else
        = button_to "Link Heidi account",
                    patient_heidi_linked_account_path(patient),
                    method: :post,
                    class: "button",
                    form: { target: "_blank",
                            rel: "noopener",
                            data: { action: "submit->heidi-linked-account#startPolling" } }
      - if heidi_sessions.any?
        h3 Recent Heidi sessions
        table
          thead
            tr
              th Created
              th Status
              th Note
              th
          tbody
            - heidi_sessions.each do |session|
              tr
                td= l(session.created_at)
                td= session.status.humanize
                td= session.consult_note_status.presence || "Not synced"
                td
                  = button_to "Sync note",
                              patient_heidi_session_sync_path(patient, session),
                              method: :post,
                              class: "button secondary"
                - if session.consult_note.present?
                  tr
                    td(colspan=4)
                      details
                        summary Synced note
                        pre.whitespace-pre-wrap= session.consult_note

  - slots.each do |slot|
    .lab-slot
      = sql_view_widgets_for(slot,
                             patient: patient,
                             lab: true,
                             schema_name: "site",
                             require_patient_scope: true)
