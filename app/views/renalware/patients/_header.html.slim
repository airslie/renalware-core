- back_path ||= nil
- patient = Renalware::Patients::BannerPresenter.new(patient)
/- with_hamburger = local_assigns[:with_hamburger].nil? ? true : local_assigns[:with_hamburger]

.header.patient-header(
  data-controller="patient-menu"
  data-action="resize@window->patient-menu#resize"
)
  / If screen-is-mobile-size is visible then we collapse the patient LH nav
  / (A media query rule hides and shows it, and some js looks for its visibility
  / when the browser is resized)
  #screen-is-mobile-size(data-patient-menu-target="mobileIndicator")
  dl.full-screenable
    - if back_path
      dt
      dd.back-link
        = link_to back_path do
          i.fas.fa-arrow-left
          |  Back
    dd.name.patient-menu-toggler
      button.patient-menu-toggle(
        type="button"
        aria-label="Toggle patient menu"
        aria-controls="patient-side-menu"
        aria-expanded="true"
        data-action="patient-menu#toggle"
        data-patient-menu-target="toggle"
      )
        - unless local_assigns[:skip_hamburger]
          = inline_icon(:ellipsis_vertical, size: :xxl, class: "inline-block align-text-bottom text-gray-300 hover:text-gray-50")
        span= patient

    - if patient.hospital_identifiers.all.count > 1
      - patient.hospital_identifiers.all.each do |hospital_identifier|
        dl.hospital_no
          dt= hospital_identifier[0]
          dd.selectable.clipboardable= hospital_identifier[1]
    - else
      dt= patient.hospital_identifier.name
      dd.selectable.clipboardable= patient.hospital_identifier.id
    dt= t("thead.nhs_number")
    dd.selectable.clipboardable= formatted_nhs_number(patient)
    dt= t("thead.sex")
    dd= patient.sex
    dt= t("thead.born_on")
    dd= "#{l(patient.born_on)} (#{patient.age}y)"
    dt= t("thead.modality")
    dd= patient.current_modality_description
