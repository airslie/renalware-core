- patient = Renalware::PatientPresenter.new(worry.patient)
- toggle = worry.notes.present?

tbody(id=dom_id(worry))
  tr
    td
      = row_toggler if toggle
    td.actions
      = link_to "Edit", edit_patient_worry_path(worry.patient)
    td.full-name= default_patient_link(patient)
    td= patient.nhs_number
    td= patient.hospital_identifier
    td= patient.sex.code
    td= patient.born_on
    td= patient.age
    td= l(worry.created_at.to_date)
    td.text-center
      - if toggle
        = inline_icon(:chat_bubble_more, size: :md, title: worry.notes, class: "text-yellow-500 hover:text-yellow-600")
    td= worry.worry_category&.name
    td= worry.created_by.to_s
    td= patient.current_modality
  - if toggle
    tr
      td
      td(colspan=11)
        .py-2
          .flex.items-center
            .flex-shrink-0
              = inline_icon(:chat_bubble_more, size: :md, title: worry.notes, class: "text-yellow-500 hover:text-yellow-600")
            .flex-grow
              b.px-2 Notes:
              = worry.notes

  - else
    tr
