doctype html
html lang="en"
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1.0"
    title= yield(:page_title)
    = stylesheet_link_tag "renalware/core", media: :all

  body.error-page
    nav.error-navigation(role="navigation" aria-label="Home")
      a.error-navigation__home(href="/") Renalware

    .error-content= yield

    = render "renalware/navigation/footer"
