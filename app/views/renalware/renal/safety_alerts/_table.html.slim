table.safety-alerts
  thead
    tr
      th.col-width-large Patient
      th.col-width-reference-no Hosp. No.
      th Rule
      th Alert type
      th.col-width-date-time Created at
      - if historical
        th.col-width-date-time Resolved at
      - else
        th.col-width-small
  tbody
    = render partial: "safety_alert", collection: alerts, locals: { historical: historical }

== pagy.series_nav if pagy.pages > 1
