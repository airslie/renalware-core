= content_for(:filters) do
  .search-form.filters
    = form_with url: admin_safety_alert_rule_executions_path, method: :get do
      .flex.flex-wrap.-mx-3.mb-6
        .w-full.md:w-1/3.px-3.mb-6.md:mb-0
          label Safety rule
          = select_tag :safety_alert_rule_id,
                       options_from_collection_for_select(rules, :id, :name, selected_rule_id),
                       include_blank: "All safety rules"
        .w-full.md:w-1/5.px-3.mb-6.md:mb-0
          .mt-6
            = submit_tag "Filter", class: "button"
            = link_to "Reset",
                      admin_safety_alert_rule_executions_path,
                      class: "button secondary"

= within_new_admin_layout(title: "Safety Rule Executions") do
  table
    thead
      tr
        th.col-width-small ID
        th Rule
        th Status
        th.col-width-date-time Started at
        th.col-width-date-time Finished at
        th Matched
        th Created
        th Duration ms
        th Error
    tbody
      - executions.each do |execution|
        tr
          td= execution.id
          td= execution.safety_alert_rule.name
          td= execution.status
          td= l(execution.started_at)
          td= l(execution.finished_at) if execution.finished_at
          td= execution.matched_count
          td= execution.created_count
          td= execution.duration_ms
          td= execution.error_message.to_s.truncate(140)

  == pagy.series_nav if pagy.pages > 1
