- heidi_sessions = clinic_visit.heidi_sessions.order(created_at: :desc)

- if heidi_sessions.any?
  article.general
    header
      h2 Heidi

    table
      thead
        tr
          th Created
          th Status
          th Note
          th Last checked
      tbody
        - heidi_sessions.each_with_index do |session, index|
          tr
            td= l(session.created_at)
            td(data-heidi-session-poller-target=("status" if index.zero?))
              = session.status.humanize
            td(data-heidi-session-poller-target=("noteStatus" if index.zero?))
              = session.consult_note_status.presence || "Not ready"
            td(data-heidi-session-poller-target=("lastChecked" if index.zero?))
              = session.last_synced_at.present? ? l(session.last_synced_at) : "Pending"
