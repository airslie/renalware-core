= within_patient_layout(title: t("new_record.page_title"),
  breadcrumbs: breadcrumb_for("Clinic Visits", patient_clinic_visits_path(patient))) do

  .document
    = simple_form_for [patient, clinic_visit],
        as: :clinic_visit,
        url: patient_clinic_visits_path(patient),
        html: { \
          autocomplete: "off",
          data: { \
            controller: "heidi-clinic-visit-launch",
            "heidi-clinic-visit-launch-account-url-value": new_patient_heidi_linked_account_path(patient),
            "heidi-clinic-visit-launch-close-preparation-tab-value": close_heidi_preparation_tab,
            "heidi-clinic-visit-launch-preparation-url-value": heidi_preparation_path,
            "heidi-clinic-visit-launch-status-url-value": patient_heidi_linked_account_path(patient) \
          } \
        },
        wrapper: "horizontal_form" do |f|

      - if Renalware::Heidi::Client.configured?
        .form-actions.mb-4
          = f.submit "Save and launch Heidi",
                     name: "launch_heidi",
                     class: "btn btn-secondary",
                     disabled: true,
                     data: { \
                       action: "click->heidi-clinic-visit-launch#open",
                       "heidi-clinic-visit-launch-target": "button" \
                     }

      input(type="hidden"
            name="clinic_visit[built_from_appointment_id]"
            value="#{built_from_appointment&.id}")

      = render "form", f: f, clinic_options: clinic_options

      = save_or_cancel(form: f, back_path: patient_clinic_visits_path(patient))
