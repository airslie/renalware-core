= within_patient_layout( \
    title: "Edit",
    breadcrumbs: breadcrumb_for("Clinic Visits", patient_clinic_visits_path(patient)) \
  ) do

  - latest_heidi_session = clinic_visit.heidi_sessions.order(created_at: :desc).first
  - poller_data = {}
  - if latest_heidi_session&.launched?
    - poller_data = { \
        controller: "heidi-session-poller",
        "heidi-session-poller-url-value": patient_clinic_visit_heidi_session_path(patient, clinic_visit) \
      }

  .document(data=poller_data)
    = render "heidi_sessions", clinic_visit: clinic_visit

    = simple_form_for [patient, clinic_visit],
      as: :clinic_visit,
      url: patient_clinic_visit_path(patient, clinic_visit),
      html: { autocomplete: "off" },
      wrapper: :horizontal_form do |f|

      = render "form", f: f, clinic_options: clinic_options
      = save_or_cancel(form: f, back_path: patient_clinic_visits_path(patient))
