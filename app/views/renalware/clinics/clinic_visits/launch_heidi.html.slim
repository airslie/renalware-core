= within_patient_layout( \
    title: "Launching Heidi",
    breadcrumbs: breadcrumb_for("Clinic Visits", patient_clinic_visits_path(patient)) \
  ) do

  .document
    article
      header
        h2 Opening Heidi
      p Heidi has been linked to this clinic visit.
      p
        = link_to "Open Heidi session",
                  heidi_launch_url,
                  class: "btn btn-primary",
                  target: "_blank",
                  rel: "noopener"
      p
        = link_to "Return to clinic visit",
                  edit_clinic_visit_url,
                  class: "btn btn-secondary"

  javascript:
    var heidiWindow = window.open("", "renalware-heidi-session")
    if (heidiWindow) {
      heidiWindow.opener = null
      heidiWindow.location = "#{j(heidi_launch_url)}"
    }
    window.setTimeout(function() {
      window.location.href = "#{j(edit_clinic_visit_url)}"
    }, 500)
