.admin-menu(
  data-controller="admin-menu-filter"
  data-action="keydown@window->admin-menu-filter#focusShortcut"
)
  /h2.admin-menu__heading Admin

  .admin-menu-search role="search"
    label.sr-only for="admin-menu-search" Search admin menu
    .admin-menu-search__field
      input#admin-menu-search.admin-menu-search__input(
        type="search"
        placeholder="Search admin menu…"
        autocomplete="off"
        data-admin-menu-filter-target="query"
        data-action="input->admin-menu-filter#filter search->admin-menu-filter#filter keydown.esc->admin-menu-filter#clear"
      )
      button.admin-menu-search__clear(
        type="button"
        aria-label="Clear admin menu search"
        title="Clear search"
        hidden=true
        data-admin-menu-filter-target="clear"
        data-action="admin-menu-filter#clear"
      ) ×
    p.admin-menu-search__status(
      aria-live="polite"
      hidden=true
      data-admin-menu-filter-target="status"
    )

  ul.side-nav.side-nav--admin
    - primary_items.each do |menu_item|
      = render_menu_item(menu_item)

    - menu_sections.each do |section|
      li.admin-menu__section(
        class=section.key.to_s.dasherize
        data-admin-menu-filter-target="group"
      )
        details(open=section_active?(section))
          summary.admin-menu__section-summary= section.title
          ul.admin-menu__section-items
            - section.items.each do |menu_item|
              = render_menu_item(menu_item, section_title: section.title)
