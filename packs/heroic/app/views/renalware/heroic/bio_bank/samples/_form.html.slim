= simple_form_for(sample,
  as: :sample,
  wrapper: :horizontal_form,
  url: url) do |f|

  - if sample.persisted?
    .row
      .small-12.medium-4.large-3.columns= f.label :sample_type
      .small-12.medium-8.large-9.columns= sample.sample_type.name
    br
  - else
    = f.input :sample_type_id,
              wrapper: :horizontal_medium,
              collection: Renalware::Heroic::BioBank::SampleType.all

  = f.input :collected_at, as: :datetime_picker, wrapper: :horizontal_datepicker
  = f.input :received_at, as: :datetime_picker, wrapper: :horizontal_datepicker
  = f.input :processed_at, as: :datetime_picker, wrapper: :horizontal_datepicker
  = f.input :storage_location, wrapper: :horizontal_large
  = f.input :notes

  = f.submit "Save", class: :button
  = " or "
  = link_to "Cancel", :back
